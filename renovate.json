{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "description": "Renovate configuration for rc-track-rental",
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "America/New_York",
  "prHourlyLimit": 3,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge dev dependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group Prisma packages",
      "groupName": "prisma",
      "matchPackageNames": [
        "/^@?prisma/"
      ]
    },
    {
      "description": "Group React packages",
      "groupName": "react",
      "matchPackageNames": [
        "/^react/",
        "/^@types/react/"
      ]
    },
    {
      "description": "Group Next.js packages",
      "groupName": "nextjs",
      "matchPackageNames": [
        "/^next/",
        "/^eslint-config-next/"
      ]
    },
    {
      "description": "Group Stripe packages",
      "groupName": "stripe",
      "matchPackageNames": [
        "/^@?stripe/"
      ]
    },
    {
      "description": "Group Radix UI packages",
      "groupName": "radix-ui",
      "matchPackageNames": [
        "/^@radix-ui/"
      ]
    },
    {
      "description": "Group testing packages",
      "groupName": "testing",
      "matchPackageNames": [
        "/vitest/",
        "/@vitest/",
        "/playwright/",
        "/@playwright/"
      ]
    },
    {
      "description": "Group TypeScript and types",
      "groupName": "typescript",
      "matchPackageNames": [
        "/^typescript$/",
        "/^@types//"
      ]
    },
    {
      "description": "Require approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "automerge": true
  }
}
