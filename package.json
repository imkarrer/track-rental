{
  "name": "rc-track-rental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "./dev-start.sh && npm run dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:local": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:ci": "npm run build:local && npm run start",
    "lint": "next lint",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "test:e2e:local": "./dev-start.sh e2e-local",
    "test:e2e:local:ui": "playwright test --ui",
    "test:e2e:local:headed": "playwright test --headed",
    "test:e2e:ci": "./dev-start.sh e2e-ci",
    "test:e2e": "./dev-start.sh e2e-ci",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:stripe-secret": "docker-compose logs stripe-cli | grep 'whsec_'",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:studio:safe": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/rc_track_rental\" prisma studio",
    "create-admin": "dotenv -e .env.local -- tsx scripts/create-admin.ts",
    "check-role": "dotenv -e .env.local -- tsx scripts/check-user-role.ts",
    "check-user": "dotenv -e .env.local -- tsx scripts/check-user.ts",
    "storage:init": "dotenv -e .env.local -- tsx scripts/init-minio.ts",
    "storage:list": "dotenv -e .env.local -- tsx scripts/list-images.ts",
    "seed:dev": "dotenv -e .env.local -- tsx scripts/seed-dev-data.ts",
    "cleanup-reservations": "dotenv -e .env.local -- tsx scripts/cleanup-expired-reservations.ts",
    "cron:run": "node scripts/run-cron-jobs.js",
    "cron:cleanup": "node scripts/run-cron-jobs.js cleanup",
    "cron:abandoned": "node scripts/run-cron-jobs.js abandoned",
    "cron:reminders": "node scripts/run-cron-jobs.js reminders",
    "check:nextjs15": "tsx scripts/check-nextjs15-compatibility.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@hookform/resolvers": "^5.0.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "@tanstack/react-query": "^5.56.0",
    "@types/nodemailer": "^7.0.4",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.11",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-day-picker": "^8.10.0",
    "react-easy-crop": "^5.0.4",
    "react-hook-form": "^7.52.0",
    "server-only": "^0.0.1",
    "stripe": "^20.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.1.0",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  }
}
