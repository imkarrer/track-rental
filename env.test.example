# E2E Test Environment Variables
# Copy this file to .env.test.local for local development
# In CI/Production, these should be set as GitHub secrets
#
# Usage modes:
#   ./dev-start.sh e2e-local  - Uses current dev environment
#   ./dev-start.sh e2e-ci     - Fresh environment setup + tests
#   ./dev-start.sh e2e-prod   - Tests against production (no local services)

# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================
# For local/CI: Created by e2e-seed.ts script
# For production: Must already exist as an ADMIN user
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
TEST_USER_FIRST_NAME=Test
TEST_USER_LAST_NAME=Admin

# =============================================================================
# STRIPE TEST CARD
# =============================================================================
# Official Stripe test cards: https://stripe.com/docs/testing#cards
# Default: 4242424242424242 - always succeeds
# For production with live Stripe: Use a real card with your $1 test track
TEST_STRIPE_CARD_NUMBER=4242424242424242
TEST_STRIPE_CARD_EXPIRY=12/34
TEST_STRIPE_CARD_CVC=123
TEST_STRIPE_CARD_ZIP=90001

# =============================================================================
# BASE URL
# =============================================================================
# For local/CI testing:
BASE_URL=http://localhost:3000
# For production testing:
# BASE_URL=https://your-production-url.com

# =============================================================================
# TEST TRACK CONFIGURATION (for production e2e tests)
# =============================================================================
# Set this to the UUID of your test-only track in production
# This track should be:
#   - Marked as testOnly=true (hidden from public users)
#   - Priced at $1 or minimal amount for real payment testing
# Leave blank for local/CI testing (will pick first available track)
# TEST_TRACK_ID=

# =============================================================================
# E2E SEED OPTIONS (for e2e-seed.ts script)
# =============================================================================
# Set CREATE_TEST_TRACK=true to create a hidden test track
# CREATE_TEST_TRACK=true
# TEST_TRACK_NAME=E2E Test Track (Hidden)
# TEST_TRACK_BASE_PRICE=1.00
# TEST_TRACK_CATEGORY=ROAD

# =============================================================================
# DATABASE (not needed for e2e-prod mode)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rc_track_rental

# =============================================================================
# NEXTAUTH (not needed for e2e-prod mode)
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# =============================================================================
# STRIPE (not needed for e2e-prod mode - production uses its own config)
# =============================================================================
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_will_be_auto_populated

# =============================================================================
# MOCK SERVICES (only for local/CI testing)
# =============================================================================
USE_STRIPE_MOCK=true
USE_GOOGLE_MAPS_MOCK=true
USE_EMAIL_MOCK=true
